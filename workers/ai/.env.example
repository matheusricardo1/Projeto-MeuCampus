# === Redis (BullMQ job queue + pub/sub) ===
# Either REDIS_URL, or REDIS_HOST/REDIS_PORT (REDIS_URL takes precedence).
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
# Optional
REDIS_PASSWORD=

# === AI chat queue/channel names — must match the API's values, only override together ===
AI_CHAT_QUEUE=ai-chat
AI_CHAT_CANCEL_CHANNEL=ai:chat:cancel
AI_CHAT_RESULT_CHANNEL=ai:chat:result
AI_CHAT_WORKER_CONCURRENCY=2

# === AI providers. The worker uses the first configured provider in this order: ===
# GEMINI_API_KEY, DEEP_SEEK_AI_API_KEY, OPENAI_API_KEY.
GEMINI_API_KEY=
GEMINI_AI_MODEL=gemini-2.5-flash
DEEP_SEEK_AI_API_KEY=
DEEP_SEEK_AI_BASE_URL=https://api.deepseek.com
DEEP_SEEK_AI_MODEL=deepseek-v4-flash
OPENAI_API_KEY=
AI_CHAT_MODEL=gpt-4o-mini

# === MCP tool servers the AI can call, e.g. the API's internal MCP endpoint ===
# Comma-separated list of MCP server URLs.
MCP_SERVER_URLS=
# Must match the API's INTERNAL_API_SECRET
INTERNAL_API_SECRET=replace-with-a-long-random-secret
