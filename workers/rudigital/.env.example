# === Redis (BullMQ job queue) ===
REDIS_URL=redis://localhost:6379
RUDIGITAL_SCRAPE_QUEUE=rudigital-scrape
RUDIGITAL_SCRAPE_WORKER_CONCURRENCY=10

# Must match the same value used by the API — encrypts/decrypts cached RU Digital data in Redis
RUDIGITAL_CACHE_ENCRYPTION_KEY=replace-with-a-long-random-secret
