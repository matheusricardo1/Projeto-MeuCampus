# === API base URL ===
EXPO_PUBLIC_ECAMPUS_API_URL=http://127.0.0.1:3001
# Fallback used only when EXPO_PUBLIC_ECAMPUS_API_URL is not set (e.g. web build via Next.js)
NEXT_PUBLIC_ECAMPUS_API_URL=http://127.0.0.1:3001

# Optional. Set to "development" to enable dev-only behavior.
EXPO_PUBLIC_APP_ENV=development
